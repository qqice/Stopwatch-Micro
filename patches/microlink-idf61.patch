diff --git a/components/microlink/components/wireguard_lwip/src/wireguardif_diag.h b/components/microlink/components/wireguard_lwip/src/wireguardif_diag.h
new file mode 100644
index 0000000..6d81847
--- /dev/null
+++ b/components/microlink/components/wireguard_lwip/src/wireguardif_diag.h
@@ -0,0 +1,18 @@
+/* Bounded observational probes: each call site samples twice per boot.
+ * Address API checks the containing heap, not just the individual allocation.
+ * No key, packet bytes, abort, or repair. Counters are used only in WG owner.
+ */
+#ifndef WIREGUARDIF_DIAG_H
+#define WIREGUARDIF_DIAG_H
+#include "esp_heap_caps.h"
+#include "esp_log.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+static inline void wireguardif_diag(const char *stage, const void *addr, unsigned *budget) {
+    if (*budget >= 2) return;
+    ++*budget;
+    bool ok = addr && heap_caps_check_integrity_addr((intptr_t)addr, false);
+    ESP_LOGI("wg_heap_diag", "stage=%s addr=%p heap_ok=%d stack_hwm=%u sample=%u/2",
+             stage, addr, ok, (unsigned)uxTaskGetStackHighWaterMark(NULL), *budget);
+}
+#endif
diff --git a/components/microlink/components/wireguard_lwip/src/wireguardif_owner.h b/components/microlink/components/wireguard_lwip/src/wireguardif_owner.h
new file mode 100644
index 0000000..3ec90d5
--- /dev/null
+++ b/components/microlink/components/wireguard_lwip/src/wireguardif_owner.h
@@ -0,0 +1,21 @@
+/* Synchronous, re-entrant owner dispatch for ESP-IDF lwIP.
+ * Never call with a mutex needed by TCPIP callbacks. The callback must not
+ * use BSD sockets or wait for work on TCPIP. With core locking off, crypto
+ * executes on TCPIP; with it on, the caller executes while holding the core.
+ */
+#ifndef WIREGUARDIF_OWNER_H
+#define WIREGUARDIF_OWNER_H
+#include <stdbool.h>
+#include "lwip/tcpip.h"
+#include "lwip/sys.h"
+static inline bool wireguardif_owner_current(void) {
+    return sys_thread_tcpip(LWIP_CORE_LOCK_QUERY_HOLDER);
+}
+static inline err_t wireguardif_owner_call(tcpip_callback_fn fn, void *ctx) {
+    if (wireguardif_owner_current()) {
+        fn(ctx);
+        return ERR_OK;
+    }
+    return tcpip_callback_wait(fn, ctx);
+}
+#endif
diff --git a/components/microlink/components/wireguard_lwip/src/wireguardif_rx_stats.h b/components/microlink/components/wireguard_lwip/src/wireguardif_rx_stats.h
new file mode 100644
--- /dev/null
+++ b/components/microlink/components/wireguard_lwip/src/wireguardif_rx_stats.h
@@ -0,0 +1,87 @@
+/* Boot-cumulative numeric-only observations. No reset or packet retention.
+ * Relaxed 32-bit atomics: snapshot fields are independent, not transactional;
+ * increments wrap modulo 2^32. No locks, timers, or network operations. */
+#ifndef WIREGUARDIF_RX_STATS_H
+#define WIREGUARDIF_RX_STATS_H
+#include <stdint.h>
+#include <stddef.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct {
+    uint32_t derp_frame;
+    uint32_t derp_enqueue;
+    uint32_t derp_drop;
+    uint32_t wg_dequeue;
+    uint32_t wg_unavailable;
+    uint32_t pbuf_fail;
+    uint32_t receiver_index_miss;
+    uint32_t key_reject;
+    uint32_t inner_pbuf_fail;
+    uint32_t decrypt_fail;
+    uint32_t replay_drop;
+    uint32_t inner_reject;
+    uint32_t inner_ok;
+    uint32_t input_ok;
+    uint32_t input_error;
+    uint32_t tcp_synack;
+    uint32_t owner_dispatch_drop;
+    uint32_t owner_processed;
+    uint32_t transport_rx;
+    uint32_t invalid_packet;
+    uint32_t empty_keepalive;
+    uint32_t header_short_read;
+    uint32_t header_resumed;
+    uint32_t header_timeout;
+    uint32_t derp_read_eof;
+} wireguardif_rx_stats_t;
+enum {
+    WG_RX_DERP_FRAME,
+    WG_RX_DERP_ENQUEUE,
+    WG_RX_DERP_DROP,
+    WG_RX_WG_DEQUEUE,
+    WG_RX_WG_UNAVAILABLE,
+    WG_RX_PBUF_FAIL,
+    WG_RX_RECEIVER_INDEX_MISS,
+    WG_RX_KEY_REJECT,
+    WG_RX_INNER_PBUF_FAIL,
+    WG_RX_DECRYPT_FAIL,
+    WG_RX_REPLAY_DROP,
+    WG_RX_INNER_REJECT,
+    WG_RX_INNER_OK,
+    WG_RX_INPUT_OK,
+    WG_RX_INPUT_ERROR,
+    WG_RX_TCP_SYNACK,
+    WG_RX_OWNER_DISPATCH_DROP,
+    WG_RX_OWNER_PROCESSED,
+    WG_RX_TRANSPORT_RX,
+    WG_RX_INVALID_PACKET,
+    WG_RX_EMPTY_KEEPALIVE,
+    WG_RX_HEADER_SHORT_READ,
+    WG_RX_HEADER_RESUMED,
+    WG_RX_HEADER_TIMEOUT,
+    WG_RX_DERP_READ_EOF,
+    WG_RX_COUNT
+};
+extern uint32_t wireguardif_rx_counters[WG_RX_COUNT];
+static inline void wireguardif_rx_count(unsigned field) {
+    __atomic_fetch_add(&wireguardif_rx_counters[field], 1U, __ATOMIC_RELAXED);
+}
+wireguardif_rx_stats_t wireguardif_rx_stats(void);
+/* IPv4 only (current quota transport), excludes fragments and truncated TCP.
+ * Read bytes only after authenticated/replay/allowed-source/length gates. */
+static inline int wireguardif_rx_is_synack(const void *payload, size_t length) {
+    const uint8_t *ip = (const uint8_t *)payload;
+    if (!ip || length < 20 || (ip[0] >> 4) != 4 || ip[9] != 6) return 0;
+    size_t ihl = (ip[0] & 15U) * 4U;
+    size_t total = ((size_t)ip[2] << 8) | ip[3];
+    if (ihl < 20 || total > length || total < ihl + 20 ||
+        (ip[6] & 0x3FU) || ip[7]) return 0;
+    const uint8_t *tcp = ip + ihl;
+    size_t thl = (tcp[12] >> 4) * 4U;
+    return thl >= 20 && thl <= total - ihl && (tcp[13] & 0x12U) == 0x12U;
+}
+#ifdef __cplusplus
+}
+#endif
+#endif
