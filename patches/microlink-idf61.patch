+
+static bool derp_desired_region(microlink_t *ml, uint16_t *desired) {
+    if (!ml->derp_map_lock || !ml->events) return false;
+    if (xSemaphoreTake(ml->derp_map_lock, portMAX_DELAY) != pdTRUE) return false;
+    bool ready = derp_coord_ready_locked(ml);
+    if (ready) *desired = derp_desired_region_locked(ml);
+    xSemaphoreGive(ml->derp_map_lock);
+    return ready;
+}
