+/* Caller holds derp_map_lock, including the count check. */
+static bool derp_coord_ready_locked(microlink_t *ml) {
+    EventBits_t bits = xEventGroupGetBits(ml->events);
+    return (bits & ML_EVT_COORD_REGISTERED) && !(bits & ML_EVT_SHUTDOWN_REQUEST) &&
+           ml->derp_region_count > 0;
