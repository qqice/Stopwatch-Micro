+        "{\"PeersChangedPatch\":[{\"NodeID\":99,\"DERPRegion\":903}]}",
+        "{\"PeersChangedPatch\":[{\"NodeID\":42,\"DERPRegion\":0}]}",
+        "{\"PeersChangedPatch\":[{\"NodeID\":42,\"DERPRegion\":65536}]}",
+        "{\"PeersChangedPatch\":[{\"NodeID\":42,\"DERPRegion\":903}]}"
+    };
+    const uint16_t expected[] = {902,902,902,902,903};
+    bool ok = true;
+    for (unsigned i=0; i<sizeof(expected)/sizeof(expected[0]); ++i) {
+        cJSON *root = cJSON_Parse(cases[i]);
+        if (!root) {ok=false;break;}
+        parse_peers_from_map_response(test, root);
+        ok = ok && test->priority_peer_derp_region == expected[i];
+        cJSON_Delete(root);
+    }
+    free(test);
+    return ok ? ESP_OK : ESP_FAIL;
+}
