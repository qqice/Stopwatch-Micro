 namespace internal {
+// Logging is best effort: an absent USB console must not abort the firmware.
+template <typename... Args>
+void print_safe(fmt::format_string<Args...> format, Args&&... args)
+{
+    const auto text = fmt::format(format, std::forward<Args>(args)...);
+    (void)std::fwrite(text.data(), 1, text.size(), stdout);
+}
+template <typename... Args>
+void print_safe(const fmt::text_style& style, fmt::format_string<Args...> format, Args&&... args)
+{
+    const auto text = fmt::format(style, format, std::forward<Args>(args)...);
+    (void)std::fwrite(text.data(), 1, text.size(), stdout);
+}
 void print_tag_time();
 void print_tag_level(const LogLevel_t& level);
 LogLevel_t get_log_level();
